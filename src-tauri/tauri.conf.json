{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil",
  "version": "0.1.0",
  "identifier": "app.veil.local",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420/censor/", "beforeDevCommand": "npm run dev -- --host 127.0.0.1", "beforeBuildCommand": "npm run build:desktop" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Veil", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 640, "resizable": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:1420 ws://localhost:1420" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
